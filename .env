# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://emissionledger:changeme@localhost:5432/emissionledger
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS Cognito ───────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=changeme
COGNITO_REGION=ap-south-1

# ── AWS KMS ───────────────────────────────────────────────────────────────────
KMS_MASTER_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/mrk-xxxxxxxx

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_DOCUMENTS_BUCKET=emissionledger-documents-prod
S3_REPORTS_BUCKET=emissionledger-reports-prod

# ── Services ──────────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth:8001
INGESTION_SERVICE_URL=http://ingestion:8002
CALCULATION_SERVICE_URL=http://calculation:8003
REPORTING_SERVICE_URL=http://reporting:8004
AUDIT_SERVICE_URL=http://audit:8005
NOTIFICATION_SERVICE_URL=http://notification:8006

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-use-secrets-manager-in-prod
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── ML ────────────────────────────────────────────────────────────────────────
SAGEMAKER_INVOICE_CLASSIFIER_ENDPOINT=emissionledger-invoice-classifier-prod
SAGEMAKER_SCOPE3_ESTIMATOR_ENDPOINT=emissionledger-scope3-estimator-prod
MLFLOW_TRACKING_URI=https://mlflow.emissionledger.in

# ── Integrations ──────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=changeme
ZOHO_CLIENT_SECRET=changeme
SENTRY_DSN=https://xxx@sentry.io/xxx
DATADOG_API_KEY=changeme

# ── Feature Flags ─────────────────────────────────────────────────────────────
LAUNCHDARKLY_SDK_KEY=changeme

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=changeme-32-byte-random-string-here
ALLOWED_HOSTS=localhost,127.0.0.1,*.emissionledger.in
CORS_ORIGINS=http://localhost:5173,https://app.emissionledger.in
